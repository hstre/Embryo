  "nodes": [
    {
      "id": "goal-0001",
      "kind": "goal",
      "status": "open",
      "text": "Collect knowledge about how to work out what a text says, and connect the pieces you collected.",
      "source": "seed",
      "created_event": 0
    },
    {
      "id": "observation-01",
      "kind": "observation",
      "status": "given",
      "text": "A claim is checkable only if it carries the exact offsets of the passage it was taken from. Without them a reader cannot return to the source.",
      "source": "hstre/Budget-Review, src/budget_review/gate.py",
      "created_event": 0,
      "ordinal": 0
    },
    {
      "id": "observation-02",
      "kind": "observation",
      "status": "given",
      "text": "Checking that a quoted span occurs in the document verifies provenance and not truth. The check has no operation that can mark a claim true.",
      "source": "hstre/Budget-Review, docs/architecture.md",
      "created_event": 0,
      "ordinal": 1
    },
    {
      "id": "observation-03",
      "kind": "observation",
      "status": "given",
      "text": "The share of a document that admitted claims anchor to is a warning light and not a score. It moves with how the contract defines a claim.",
      "source": "hstre/Budget-Review, README, coverage",
      "created_event": 0,
      "ordinal": 2
    },
    {
      "id": "observation-04",
      "kind": "observation",
      "status": "given",
      "text": "A passage no claim reaches is a question for the reader and not a defect. It may be a heading, a transition, or prose that carries no claim.",
      "source": "hstre/Budget-Review, coverage_gap",
      "created_event": 0,
      "ordinal": 3
    },
    {
      "id": "observation-05",
      "kind": "observation",
      "status": "given",
      "text": "Extraction gets worse as a document grows longer, while a deterministic check over the same document does not. The two halves do not scale alike.",
      "source": "hstre/Budget-Review, claude/gold-recall-echr",
      "created_event": 0,
      "ordinal": 4
    },
    {
      "id": "observation-06",
      "kind": "observation",
      "status": "given",
      "text": "An anchor that reaches into the text of two speakers merges two positions into one node. The anchor is the only record of who said it.",
      "source": "hstre/Budget-Review, speaker boundaries",
      "created_event": 0,
      "ordinal": 5
    },
    {
      "id": "observation-07",
      "kind": "observation",
      "status": "given",
      "text": "A rule can settle whether two strings share a passage. It cannot settle what a passage means, and it damages a judgement when it is allowed to try.",
      "source": "hstre/DESi, PROJEKTABSCHLUSS.md",
      "created_event": 0,
      "ordinal": 6
    },
    {
      "id": "observation-08",
      "kind": "observation",
      "status": "given",
      "text": "An extractor that always answers is worse than one that abstains outside a closed set of kinds. Anything else is intentionally ignored.",
      "source": "hstre/DESi, self_audit/extractor.py",
      "created_event": 0,
      "ordinal": 7
    },
    {
