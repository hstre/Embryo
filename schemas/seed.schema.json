{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hstre/Embryo/schemas/seed.schema.json",
  "title": "Embryo seed",
  "type": "object",
  "required": ["embryo_id", "goal", "observations"],
  "additionalProperties": false,
  "properties": {
    "embryo_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "observations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "text", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "source": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_proposals": { "type": "integer", "minimum": 1 },
        "max_attempts_per_need": { "type": "integer", "minimum": 1 },
        "max_cells_per_generation": { "type": "integer", "minimum": 1 },
        "max_generations": { "type": "integer", "minimum": 1 },
        "energy_budget": { "type": "integer", "minimum": 1 },
        "max_text_chars": { "type": "integer", "minimum": 1 },
        "local_context_limit": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
