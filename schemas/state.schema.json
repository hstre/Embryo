{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hstre/Embryo/schemas/state.schema.json",
  "title": "Embryo authoritative state",
  "type": "object",
  "required": ["schema_version", "embryo_id", "generation", "energy_spent", "next_node_seq", "next_event_seq", "ledger_head", "config", "nodes", "edges", "needs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "embryo_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "generation": { "$ref": "#/$defs/nonNegativeInteger" },
    "energy_spent": { "$ref": "#/$defs/nonNegativeInteger" },
    "next_node_seq": { "$ref": "#/$defs/positiveInteger" },
    "next_event_seq": { "$ref": "#/$defs/positiveInteger" },
    "ledger_head": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }] },
    "config": {
      "type": "object",
      "required": ["target_claims", "max_attempts_per_need", "max_cells_per_generation", "max_generations", "energy_budget", "max_text_chars", "local_observation_limit"],
      "additionalProperties": false,
      "properties": {
        "target_claims": { "$ref": "#/$defs/positiveInteger" },
        "max_attempts_per_need": { "$ref": "#/$defs/positiveInteger" },
        "max_cells_per_generation": { "$ref": "#/$defs/positiveInteger" },
        "max_generations": { "$ref": "#/$defs/positiveInteger" },
        "energy_budget": { "$ref": "#/$defs/positiveInteger" },
        "max_text_chars": { "$ref": "#/$defs/positiveInteger" },
        "local_observation_limit": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "needs": { "type": "array", "items": { "$ref": "#/$defs/need" } }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "node": {
      "type": "object",
      "required": ["id", "kind", "status", "text", "source", "created_event"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["goal", "observation", "claim", "challenge", "synthesis"] },
        "status": { "enum": ["given", "open", "unverified", "supported", "challenged", "superseded", "retracted", "accepted"] },
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "created_event": { "$ref": "#/$defs/nonNegativeInteger" },
        "ordinal": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to", "relation", "created_event"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "relation": { "enum": ["addresses", "supports", "challenges", "supersedes", "synthesizes"] },
        "created_event": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "need": {
      "type": "object",
      "required": ["id", "kind", "target_id", "status", "attempts", "created_generation", "priority"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["EXPLORE", "VERIFY", "REPAIR", "SYNTHESIZE"] },
        "target_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["open", "resolved", "exhausted"] },
        "attempts": { "$ref": "#/$defs/nonNegativeInteger" },
        "created_generation": { "$ref": "#/$defs/nonNegativeInteger" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 100 },
        "stage": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    }
  }
}
